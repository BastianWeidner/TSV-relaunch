# Strato / Apache: Einstellungen für die statische Seite
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

# Notizen, Vorlagen und Editor-Sicherungen nie ausliefern
<FilesMatch "(\.(md|bak|orig|swp|log|ini|sh|py)|~)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # immer HTTPS und ohne www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://tsv-fischach-schwimmen.de%{REQUEST_URI} [L,R=301]

  # alte Joomla-Adressen auf die neuen Seiten weiterleiten
  RewriteRule ^index\.php/impressum/?$ /impressum/ [L,R=301]
  RewriteRule ^index\.php/datenschutz/?$ /datenschutz/ [L,R=301]
  RewriteRule ^index\.php/haftungsausschluss/?$ /impressum/ [L,R=301]
  RewriteRule ^index\.php/?$ / [L,R=301]
  RewriteRule ^(index\.php/)?blog(/.*)?$ / [L,R=301]
  RewriteRule ^index\.php/kontakt/?$ /kontakt/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Die Seite hat kein JavaScript und keine Fremdinhalte: alles nur von der eigenen Domain
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
  # HSTS: erst kurz (5 Minuten) testen; wenn HTTPS sicher läuft, max-age=31536000 setzen
  Header always set Strict-Transport-Security "max-age=300"
  <FilesMatch "\.(css|woff2|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
