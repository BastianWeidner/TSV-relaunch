# TSV Fischach Schwimmen – Apache-Konfiguration für Strato
# Immer HTTPS und ohne www, fest auf die eigene Domain
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://tsv-fischach-schwimmen.de%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html
Options -Indexes

# Notizen, Vorlagen und Editor-Sicherungen nie ausliefern
<FilesMatch "(\.(md|bak|orig|swp|log|ini|sh|py)|~)$">
  Require all denied
</FilesMatch>

# Weiterleitungen der alten Joomla-URLs (NE, damit #anker erhalten bleiben) (Inventar vom 29.10.2026)
RewriteRule ^index\.php/?$ / [R=301,NE,L]
RewriteRule ^(index\.php/)?schwimmkurse/robby-kurs/?$ /schwimmkurse.html#robby [R=301,NE,L]
RewriteRule ^(index\.php/)?schwimmkurse/seepferdchenkurse/?$ /schwimmkurse.html#seepferdchen [R=301,NE,L]
RewriteRule ^(index\.php/)?schwimmkurse/?$ /schwimmkurse.html [R=301,NE,L]
RewriteRule ^(index\.php/)?gruppen/gruppe-i/?$ /training.html#gruppe-1 [R=301,NE,L]
RewriteRule ^(index\.php/)?gruppen/gruppe-ii/?$ /training.html#gruppe-2 [R=301,NE,L]
RewriteRule ^(index\.php/)?gruppen/gruppe-iii/?$ /training.html#gruppe-3 [R=301,NE,L]
RewriteRule ^(index\.php/)?gruppen/gruppe-iv/?$ /training.html#gruppe-4 [R=301,NE,L]
RewriteRule ^(index\.php/)?gruppen/a-b-kader/?$ /training.html#kader [R=301,NE,L]
RewriteRule ^(index\.php/)?gruppen/?$ /training.html [R=301,NE,L]
RewriteRule ^(index\.php/)?wassergymnastik/erwachsenenschwimmen/?$ /erwachsene.html#erwachsenenschwimmen [R=301,NE,L]
RewriteRule ^(index\.php/)?wassergymnastik/?$ /erwachsene.html#wassergymnastik [R=301,NE,L]
RewriteRule ^(index\.php/)?alle-kosten-auf-einem-blick/?$ /preise.html [R=301,NE,L]
RewriteRule ^(index\.php/)?impressum/?$ /impressum.html [R=301,NE,L]
RewriteRule ^(index\.php/)?datenschutz/?$ /datenschutz.html [R=301,NE,L]
RewriteRule ^(index\.php/)?haftungsausschluss/?$ /impressum.html [R=301,NE,L]
RewriteRule ^(index\.php/)?(blog|kontakt)(/.*)?$ /kontakt.html [R=301,NE,L]

# Sicherheit und Caching
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  # HSTS: Browser nutzen nur noch HTTPS. Erst kurz (5 Minuten) testen; wenn alles läuft,
  # max-age=31536000 setzen. {{csp_script}} füllt build.py mit den Hashes der Inline-Skripte.
  Header always set Strict-Transport-Security "max-age=300"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' {{csp_script}}; object-src 'none'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp
